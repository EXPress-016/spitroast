{
	"name": "spitroast",
	"version": "2.1.7",
	"description": "A simple JavaScript function patcher.",
	"main": "./dist/index.cjs",
	"module": "./dist/index.mjs",
	"types": "./dist/index.d.mts",
	"exports": {
		".": {
			"require": {
				"default": "./dist/index.cjs",
				"types": "./dist/index.d.cts"
			},
			"import": {
				"default": "./dist/index.mjs",
				"types": "./dist/index.d.mts"
			}
		}
	},
	"scripts": {
		"prepublish": "tsdown ./src/index.ts --dts --format esm,cjs",
		"test": "tsdown ./src/index.ts --dts --format esm,cjs && node --no-warnings --import ./test/setup.mjs --test ./test/index.mjs"
	},
	"repository": {
		"type": "git",
		"url": "github.com/Cumcord/spitroast"
	},
	"author": "creatable",
	"license": "CC0-1.0",
	"devDependencies": {
		"@types/node": "^22.19.19",
		"tsdown": "^0.22.0",
		"typescript": "^5.5.4"
	}
}
